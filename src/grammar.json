{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "ifc",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "statement"
      }
    },
    "statement": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "header_section"
        },
        {
          "type": "SYMBOL",
          "name": "data_section"
        },
        {
          "type": "SYMBOL",
          "name": "entity_instance"
        },
        {
          "type": "SYMBOL",
          "name": "iso_start"
        },
        {
          "type": "SYMBOL",
          "name": "iso_end"
        },
        {
          "type": "STRING",
          "value": ";"
        }
      ]
    },
    "iso_start": {
      "type": "STRING",
      "value": "ISO-10303-21;"
    },
    "iso_end": {
      "type": "STRING",
      "value": "END-ISO-10303-21;"
    },
    "header_section": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "HEADER;"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "header_entry"
          }
        },
        {
          "type": "STRING",
          "value": "ENDSEC;"
        }
      ]
    },
    "data_section": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "DATA;"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "entity_instance"
          }
        },
        {
          "type": "STRING",
          "value": "ENDSEC;"
        }
      ]
    },
    "header_entry": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "entity_name"
        },
        {
          "type": "SYMBOL",
          "name": "parameter_list"
        },
        {
          "type": "STRING",
          "value": ";"
        }
      ]
    },
    "entity_instance": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "instance_id"
        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "SYMBOL",
          "name": "entity_name"
        },
        {
          "type": "SYMBOL",
          "name": "parameter_list"
        },
        {
          "type": "STRING",
          "value": ";"
        }
      ]
    },
    "instance_id": {
      "type": "PATTERN",
      "value": "#[0-9]+"
    },
    "entity_name": {
      "type": "PATTERN",
      "value": "[A-Za-z_][A-Za-z0-9_]*"
    },
    "parameter_list": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "parameter_sequence"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "parameter_sequence": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "parameter"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": ","
              },
              {
                "type": "SYMBOL",
                "name": "parameter"
              }
            ]
          }
        }
      ]
    },
    "parameter": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "typed_parameter"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "reference"
        },
        {
          "type": "SYMBOL",
          "name": "enumeration"
        },
        {
          "type": "SYMBOL",
          "name": "list"
        },
        {
          "type": "SYMBOL",
          "name": "null_value"
        },
        {
          "type": "SYMBOL",
          "name": "omitted_value"
        }
      ]
    },
    "typed_parameter": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "entity_name"
        },
        {
          "type": "SYMBOL",
          "name": "parameter_list"
        }
      ]
    },
    "list": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "parameter_sequence"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "reference": {
      "type": "PATTERN",
      "value": "#[0-9]+"
    },
    "enumeration": {
      "type": "PATTERN",
      "value": "\\.[A-Za-z0-9_]+\\."
    },
    "null_value": {
      "type": "STRING",
      "value": "$"
    },
    "omitted_value": {
      "type": "STRING",
      "value": "*"
    },
    "string": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "'"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "[^']"
              },
              {
                "type": "STRING",
                "value": "''"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "'"
        }
      ]
    },
    "number": {
      "type": "PATTERN",
      "value": "-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[Ee][+-]?[0-9]+)?"
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "/*"
          },
          {
            "type": "PATTERN",
            "value": "[^*]*\\*+([^/*][^*]*\\*+)*"
          },
          {
            "type": "STRING",
            "value": "/"
          }
        ]
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}